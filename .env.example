# --- NextAuth ---
# Public base URL of your app (e.g. http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth (NextAuth Google provider) ---
GOOGLE_CLIENT_ID=""
